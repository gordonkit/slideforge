{
  "name": "slideforge",
  "version": "0.1.0",
  "description": "An AI-ready framework for creating consistent, editable PowerPoint presentations from HTML and CSS.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "slideforge": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "!dist/exporters/browser.*",
    "examples",
    "templates",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import {cpSync} from 'node:fs'; cpSync('src', 'dist', {recursive: true, filter: (source) => !/\\.tsx?$/.test(source)})\" && vite build --config vite.export.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:package": "node scripts/check-package.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gordonkit/slideforge.git"
  },
  "homepage": "https://slideforge.gordonkit.com/",
  "bugs": {
    "url": "https://github.com/gordonkit/slideforge/issues"
  },
  "keywords": [
    "powerpoint",
    "pptx",
    "presentation",
    "slides",
    "html-to-pptx",
    "react"
  ],
  "author": "GordonKit",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dom-to-pptx": "2.1.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
